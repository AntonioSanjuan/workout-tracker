{
  "root": true,
  "ignorePatterns": [],
  "plugins": ["@nx", "@stylistic"],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {
        "@nx/enforce-module-boundaries": [
          "error",
          {
            "enforceBuildableLibDependency": true,
            "allow": [],
            "depConstraints": [
              {
                "sourceTag": "type:feature",
                "onlyDependOnLibsWithTags": ["type:feature"]
              },
              {
                "sourceTag": "type:test",
                "onlyDependOnLibsWithTags": ["type:test"]
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["*.spec.ts", "*.spec.tsx", "*.spec.js", "*.spec.jsx", "*.mock.ts"],
      "env": {
        "jest": true
      }
    }
  ]
}
